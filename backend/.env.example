# --- App Configuration ---
PROJECT_NAME="Benten Audio Evaluation Framework"
API_V1_STR="/api/v1"

# --- PostgreSQL Database ---
# Note: Use 'localhost' when running the backend python process directly on your host machine.
# Use 'postgres' when running the backend inside a Docker Compose network.
POSTGRES_USER=benten_admin
POSTGRES_PASSWORD=admin_secure_pwd
POSTGRES_DB=benten
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- RabbitMQ Broker ---
# Note: Use 'localhost' when running the backend directly on your host machine.
# Use 'rabbitmq' when running the backend inside a Docker Compose network.
RABBITMQ_DEFAULT_USER=benten_mq
RABBITMQ_DEFAULT_PASS=mq_secure_pwd
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# --- Redis Cache / Result Backend ---
# Note: Use 'localhost' when running the backend directly on your host machine.
# Use 'redis' when running the backend inside a Docker Compose network.
REDIS_HOST=redis
REDIS_PORT=6379
